# Gemini API key (GOOGLE_API_KEY is checked first, then GEMINI_API_KEY)
GOOGLE_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here

# Models (all configurable; verify availability for your account)
LIVE_TRANSCRIPTION_MODEL=gemini-3.5-transcribe-live
UPLOAD_TRANSCRIPTION_MODEL=gemini-2.5-flash
ANALYSIS_MODEL=gemini-3.1-flash-lite

HOST=127.0.0.1
PORT=8000

# Storage / privacy
SAVE_SESSIONS=true
SAVE_LIVE_AUDIO=false
RETENTION_DAYS=0
MAX_UPLOAD_MB=100
EMBED_AUDIO_MAX_MB=20

# Business timezone used to resolve relative dates ("tomorrow") in conversations
CALL_TIMEZONE=Asia/Kolkata
